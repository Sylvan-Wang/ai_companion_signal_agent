# Copy this file to .env and fill in your real values.
# .env is gitignored and never committed — keep your keys safe.

# ── Required ──────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...your-key-here...

# ── Required for Phase 3 (live Reddit data) ───────────────────────────────────
# Create a Reddit app at: https://www.reddit.com/prefs/apps
# Choose "script" type. Use any redirect URI (e.g. http://localhost:8080)
REDDIT_CLIENT_ID=your-reddit-client-id
REDDIT_CLIENT_SECRET=your-reddit-client-secret
REDDIT_USER_AGENT=ai_companion_signal_agent/0.1 by your_reddit_username

# ── Phase 4 — Email delivery (optional) ──────────────────────────────────────
# If set, the agent emails you the daily report after saving it.
# Uses Gmail SMTP with an App Password (NOT your regular Gmail password).
# Create an App Password at: myaccount.google.com/apppasswords
# (Enable 2FA first, then generate a 16-char app password for "Mail")
REPORT_EMAIL_TO=you@gmail.com
SMTP_USER=you@gmail.com
SMTP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# Optional: custom SMTP server (defaults to Gmail)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587

# ── Optional run overrides ────────────────────────────────────────────────────
# Override the run date (YYYY-MM-DD). Defaults to today's UTC date.
# SIGNAL_AGENT_RUN_DATE=2026-05-10

# Dry-run mode: collect + clean only, skip LLM analysis (true/false)
# SIGNAL_AGENT_DRY_RUN=false
